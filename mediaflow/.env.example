# Protects every proxy endpoint; also the key for encrypted proxy URLs.
# Must match the MediaFlow credentials in your AIOStreams (or other client)
# proxy settings.
# Generate via: openssl rand -hex 32
API_PASSWORD=

# The host's Tailscale IP (`tailscale ip -4`). MediaFlow's own port (8888,
# plain HTTP: web UI, /metrics and the proxy API) binds only here, so it's
# reachable over the tailnet and nowhere else. Players use the public domain
# through Caddy, which hides the web UI and /metrics.
INTERFACE=
