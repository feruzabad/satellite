# Protects every proxy endpoint; also the key for encrypted proxy URLs.
# Must match the MediaFlow credentials in your AIOStreams (or other client)
# proxy settings.
# Generate via: openssl rand -hex 32
API_PASSWORD=

# IP that MediaFlow's own port (8888, plain HTTP: web UI, /metrics and the
# proxy API) binds to. Players use the public domain through Caddy either
# way; this port is for you and for clients on a private network.
#
#   127.0.0.1         Default. Reach it through an SSH tunnel:
#                       ssh -L 8888:127.0.0.1:8888 user@server
#                     then open http://localhost:8888.
#   Private/VPN IP    e.g. a Tailscale (`tailscale ip -4`) or WireGuard
#                     address. Reach it directly from that network, and point
#                     AIOStreams' internal proxy URL at http://<ip>:8888 so
#                     its API calls skip the public internet.
#
# CAUTION: Never a public IP or 0.0.0.0: it bypasses Caddy's TLS and path
# filtering. To reach the UI without a VPN or SSH, see MEDIAFLOW_ADMIN in
# caddy/.env.example instead.
INTERFACE=127.0.0.1
