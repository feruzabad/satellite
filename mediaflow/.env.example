# Protects every proxy endpoint; also the key for encrypted proxy URLs.
# Must match the MediaFlow API password in AIOStreams' Proxy settings (Apollo).
# Generate via: openssl rand -hex 32
API_PASSWORD=

# IP that MediaFlow's port (8888, plain HTTP: web UI, /metrics and the proxy
# itself) binds to. The public site goes through Caddy regardless.
#
# CAUTION: Set this to an internal IP (e.g. your Tailscale IP from
# `tailscale ip -4`), or keep 127.0.0.1 and access it via an SSH tunnel.
# Don't bind to a public interface: it bypasses Caddy's TLS and filtering.
INTERFACE=127.0.0.1
