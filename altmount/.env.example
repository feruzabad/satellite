# Signs web UI login sessions.
# Generate via: openssl rand -hex 32
JWT_SECRET=

# IP that AltMount's own port (8080, plain HTTP: web UI, API, WebDAV and the
# SABnzbd API) binds to. Players use the public domain through Caddy, which
# only exposes the stream endpoint; this port is for you and for AIOStreams.
# Open the web UI at exactly http://<this IP>:8080: it is also the login
# cookie's domain, so another hostname for the same host won't stay logged in.
#
#   127.0.0.1         Default. Reach it through an SSH tunnel:
#                       ssh -L 8080:127.0.0.1:8080 user@server
#                     then open http://127.0.0.1:8080. AIOStreams must then
#                     run on this host, or use a VPN IP instead.
#   Private/VPN IP    e.g. a Tailscale (`tailscale ip -4`) or WireGuard
#                     address. Reach it directly from that network, and point
#                     AIOStreams' AltMount URL at http://<ip>:8080 so its API
#                     calls skip the public internet.
#
# CAUTION: Never a public IP or 0.0.0.0: it bypasses Caddy's TLS and path
# filtering, exposing the web UI and API.
INTERFACE=127.0.0.1
