# Signs web UI login sessions.
# Generate via: openssl rand -hex 32
JWT_SECRET=

# The host's Tailscale IP (`tailscale ip -4`). AltMount's own port (8080,
# plain HTTP: web UI, API, WebDAV and the SABnzbd API) binds only here, so
# it's reachable over the tailnet and nowhere else. Players use the public
# domain through Caddy, which only exposes the stream endpoint.
INTERFACE=

# The host name you open the web UI at, e.g. the MagicDNS name
# <host>.<tailnet>.ts.net. It becomes the login cookie's domain, so logins
# only stick on this exact host. Empty: the Tailscale IP above.
UI_HOST=
