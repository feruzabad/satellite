(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(noindex) {
	header X-Robots-Tag "noindex, nofollow, noarchive"

	handle /robots.txt {
		root * /etc/caddy/static
		file_server
	}
}

{$MEDIAFLOW_DOMAIN} {
	{$TLS}
	import security
	import noindex

	# Web UI (landing page, URL/playlist builders, speedtest; no auth of its
	# own) and usage metrics (?api_password=). Players only need the proxy
	# endpoints; these are reachable over the tailnet at mediaflow's
	# INTERFACE port instead.
	@mediaflow_admin path / /metrics /speedtest /speedtest/* /logo.png /speedtest.js *.html
	handle @mediaflow_admin {
		respond 404
	}

	handle {
		reverse_proxy mediaflow:8888
	}
}

{$ALTMOUNT_DOMAIN} {
	{$TLS}
	import security
	import noindex

	# Players only need the stream endpoint, authorized by the download_key in
	# its URL. The web UI, API, WebDAV and SABnzbd API stay on the tailnet:
	# AIOStreams calls them over altmount's INTERFACE port.
	handle /api/files/stream {
		reverse_proxy altmount:8080
	}

	handle {
		respond 404
	}
}
