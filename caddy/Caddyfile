(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(noindex) {
	header X-Robots-Tag "noindex, nofollow, noarchive"

	handle /robots.txt {
		root * /etc/caddy/static
		file_server
	}
}

{$MEDIAFLOW_DOMAIN} {
	{$TLS}
	import security
	import noindex

	# Web UI (landing page, URL/playlist builders, speedtest) and usage
	# metrics are unauthenticated; only the proxy endpoints need to be public.
	# Both stay reachable over Tailscale on mediaflow's own port.
	@internal path / /metrics /speedtest /speedtest/* /logo.png /speedtest.js *.html
	handle @internal {
		respond 404
	}

	handle {
		reverse_proxy mediaflow:8888
	}
}
