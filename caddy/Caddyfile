(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(noindex) {
	header X-Robots-Tag "noindex, nofollow, noarchive"

	handle /robots.txt {
		root * /etc/caddy/static
		file_server
	}
}

{$MEDIAFLOW_DOMAIN} {
	{$TLS}
	import security
	import noindex

	# MediaFlow serves usage metrics without auth; nothing needs them publicly.
	handle /metrics {
		respond 404
	}

	handle {
		reverse_proxy mediaflow:8888
	}
}
