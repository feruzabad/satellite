(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(noindex) {
	header X-Robots-Tag "noindex, nofollow, noarchive"

	handle /robots.txt {
		root * /etc/caddy/static
		file_server
	}
}

# Public access to MediaFlow's web UI and metrics, picked by MEDIAFLOW_ADMIN
# (see .env.example). Only the imported snippet is parsed, so the unused
# one's empty variables are harmless.
(mediaflow_admin_off) {
	handle @mediaflow_admin {
		respond 404
	}
}

(mediaflow_admin_basic_auth) {
	handle @mediaflow_admin {
		basic_auth {
			{$MEDIAFLOW_ADMIN_USER} {$MEDIAFLOW_ADMIN_HASH}
		}
		reverse_proxy mediaflow:8888
	}
}

{$MEDIAFLOW_DOMAIN} {
	{$TLS}
	import security
	import noindex

	# Web UI (landing page, URL/playlist builders, speedtest; no auth of its
	# own) and usage metrics (?api_password=). Players only need the proxy
	# endpoints, so these stay off the public site unless enabled.
	@mediaflow_admin path / /metrics /speedtest /speedtest/* /logo.png /speedtest.js *.html
	import mediaflow_admin_{$MEDIAFLOW_ADMIN}

	handle {
		reverse_proxy mediaflow:8888
	}
}
