# Caddy's HTTPS port.
HTTPS_PORT=443

# Caddy's HTTP port (ACME challenge + HTTPS redirect).
HTTP_PORT=80

# TLS for MediaFlow. Keep as is for self-signed certificates. Leave empty to
# enable Let's Encrypt certificates.
TLS='tls internal'

# Public hostname of MediaFlow. Must match the public MediaFlow URL in your
# AIOStreams (or other client) proxy settings.
MEDIAFLOW_DOMAIN=mediaflow.example.com

# MediaFlow's web UI and /metrics on the public domain:
#   off         404 (default). Reach them privately instead, through
#               mediaflow's INTERFACE port (see mediaflow/.env.example).
#   basic_auth  Served behind the login below. For hosts without a VPN or
#               SSH access; it does make the UI visible to anyone who finds
#               the domain, protected only by this password.
MEDIAFLOW_ADMIN=off

# Login for MEDIAFLOW_ADMIN=basic_auth, ignored otherwise.
# Hash via: docker run --rm caddy:2.11.4 caddy hash-password
# Keep the single quotes: the bcrypt hash contains '$'.
MEDIAFLOW_ADMIN_USER=
MEDIAFLOW_ADMIN_HASH=''
