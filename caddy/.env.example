# Caddy's HTTPS port.
HTTPS_PORT=443

# Caddy's HTTP port (ACME challenge + HTTPS redirect).
HTTP_PORT=80

# TLS for MediaFlow. Keep as is for self-signed certificates. Leave empty to
# enable Let's Encrypt certificates.
TLS='tls internal'

# Public hostname of MediaFlow. Must match the MediaFlow URL in AIOStreams'
# Proxy settings (Apollo).
MEDIAFLOW_DOMAIN=mediaflow.example.com
