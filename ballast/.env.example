# RAM to hold, in MiB. Oracle reclaims Always Free instances that stay idle
# for 7 days: CPU (95th percentile), network and, on A1 shapes, memory all
# below 20%. Keeping memory above 20% is enough. Size this so the host's
# total use stays above 20% of its RAM with some margin, and lower it as
# real services grow. On a 12 GB A1 instance, 2048 keeps it around 24%.
SIZE_MB=2048
